@model QuizManagement.Models.QuestionLevelModel

<main id="main" class="main flex-grow-1">

    <div class="card">
        <div class="card-body">
            <h1 class="card-title">Add / Edit QuestionLevel</h1>

            <form class="row g-3 needs-validation" id="questionLevelForm" novalidate asp-controller="QuestionLevel" asp-action="AddEditQuestionLevel">
                <input type="hidden" asp-for="QuestionLevelID" />
                <div class="mb-3 row">
                <label for="questionLevel" class="col-sm-2 col-form-label"><span class="text-danger">*</span> Question Level</label>
                    <div class="col-sm-10">
                        <input type="text" class="form-control" id="questionLevel" placeholder="Enter a question level (e.g., Easy, Medium, Hard)" asp-for="QuestionLevel">
                        <span asp-validation-for="QuestionLevel" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-3 row">
                    <label for="user" class="col-sm-2 col-form-label">
                        <span class="text-danger">*</span> User ID
                    </label>
                    <div class="col-sm-10">
                        <select class="form-control" asp-for="UserID" asp-items="@(new SelectList(ViewBag.userList, "UserID", "UserName"))">
                            <option value="">Select User</option>
                        </select>
                        <span asp-validation-for="UserID" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-3 row">
                    <label for="questionLevel" class="col-sm-2 col-form-label"></label>
                    <div class="col-sm-10">
                        <button type="submit" class="btn btn-success">Save</button>
                        <a class="btn btn-danger" asp-controller="QuestionLevel" asp-action="QuestionLevelList">Cancel</a>
                    </div>
                </div>
                </form>


        </div>
    </div> 
</main>