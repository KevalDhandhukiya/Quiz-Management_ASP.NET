@using System.Data
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<main id="main" class="main flex-grow-1">
    <div class="container mt-4">
        <div class="pagetitle">
            <h1 class="text-primary">QuestionLevel List</h1>
            <nav>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item">QuestionLevel</li>
                    <li class="breadcrumb-item active">QuestionLevel List</li>
                </ol>
            </nav>
        </div><!-- End Page Title -->
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Question Levels</h5>
                <div class="mb-3 d-flex justify-content-end">
                    <button class="btn btn-danger me-2">Delete Selected</button>
                    <a class="btn btn-primary" asp-controller="QuestionLevel" asp-action="AddEdit_QuestionLevel">Add Question Level</a>
                </div>
                <span class="text-danger">@TempData["ErrorMessage"]</span>
                <table class="table  datatable table-striped">
                    <thead class="table-light">
                        <tr>
                            <th><input type="checkbox"></th>
                            <th>QUESTION LEVEL</th>
                            <th>USER NAME</th>
                            <th>ACTION</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (DataRow dataRow in Model.Rows)
                        {
                            <tr>
                                <td><input type="checkbox"></td>
                                <td>@dataRow["QuestionLevel"]</td>
                                <td>@dataRow["UserName"]</td>
                                <td>
                                    <a class="btn btn-success btn-sm" asp-controller="QuestionLevel" asp-action="AddEdit_QuestionLevel" asp-route-QuestionLevelID="@dataRow["QuestionLevelID"]">&#9998; Edit</a>
                                    <a href="/QuestionLevel/QuestionLevelDelete?QuestionLevelID=@dataRow["QuestionLevelID"]" class="btn btn-danger btn-sm">
                                        &#9998; Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>          

</main><!-- End #main -->
