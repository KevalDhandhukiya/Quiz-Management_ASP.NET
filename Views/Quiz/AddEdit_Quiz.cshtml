@model QuizManagement.Models.QuizModel
<main id="main" class="main flex-grow-1">

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Add / Edit Quiz</h5>

            <form class="row g-3 needs-validation" id="quizForm" asp-controller="Quiz" asp-action="QuizAddEdit">
                <input type="hidden" asp-for="QuizID" />
                    <div class="mb-3 row">
                        <label class="col-sm-2 col-form-label">
                            <span class="text-danger">*</span> Quiz name
                        </label>
                        <div class="col-sm-10">
                            <input type="text" class="form-control" asp-for="QuizName" placeholder="Enter Quiz Name">
                            <span class="text-danger" asp-validation-for="QuizName"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-sm-2 col-form-label">
                            <span class="text-danger">*</span> Quiz date
                        </label>
                        <div class="col-sm-10">
                            <input type="date" class="form-control" asp-for="QuizDate">
                            <span class="text-danger" asp-validation-for="QuizDate"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-sm-2 col-form-label">
                            <span class="text-danger">*</span> Total questions
                        </label>
                        <div class="col-sm-10">
                            <input type="number" class="form-control" asp-for="TotalQuestions">
                            <span class="text-danger" asp-validation-for="TotalQuestions"></span>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label for="user" class="col-sm-2 col-form-label">
                            <span class="text-danger">*</span> User ID
                        </label>
                        <div class="col-sm-10">
                            <select class="form-control" asp-for="UserID" asp-items="@(new SelectList(ViewBag.userList, "UserID", "UserName"))">
                                <option value="">Select User</option>
                            </select>
                            <span asp-validation-for="UserID" class="text-danger"></span>
                        </div>
                    </div>


                    <div class="mb-3 row">
                        <label class="col-sm-2 col-form-label text-danger"></label>
                        <div class="col-sm-10">
                            <button class="btn btn-primary" type="submit">Save</button>
                            <a class="btn btn-danger" asp-controller="Quiz" asp-action="QuizList">Cancel</a>
                        </div>
                    </div>
                </form>

        </div>
    </div> 
</main>